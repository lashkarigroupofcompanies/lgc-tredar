# NVIDIA NIM API (Free Brains)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Default Market Selection: CRYPTO | INDIAN_STOCKS | US_STOCKS
DEFAULT_MARKET=CRYPTO

# Paper Trading Capital Settings
INITIAL_PAPER_CAPITAL=100000
MAX_RISK_PER_TRADE_PERCENT=2.0
DAILY_MAX_DRAWDOWN_PERCENT=5.0

# System Ports
BACKEND_PORT=8000
